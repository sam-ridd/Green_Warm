{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run experiment",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_experiment.py",
      "args": ["--region", "india", "--predictor", "mean"],
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "console": "integratedTerminal"
    }
  ]
}
